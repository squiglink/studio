{
  "name": "squiglink-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "axios": "^1.7.9",
    "flowbite": "^2.5.2",
    "flowbite-vue": "^0.1.9",
    "pinia": "^2.2.6",
    "ts-case-convert": "^2.1.0",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "vue3-toastify": "^0.2.8"
  },
  "devDependencies": {
    "@iconify/vue": "^4.2.0",
    "@playwright/test": "^1.48.2",
    "@tsconfig/node22": "^22.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.9.3",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/eslint-plugin": "1.1.7",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-plugin-oxlint": "^0.11.0",
    "eslint-plugin-playwright": "^2.0.0",
    "eslint-plugin-vue": "^9.30.0",
    "jsdom": "^25.0.1",
    "npm-run-all2": "^7.0.1",
    "oxlint": "^0.11.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-vue-devtools": "^7.5.4",
    "vitest": "^2.1.4",
    "vue-tsc": "^2.1.10"
  },
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.8": ">=3.3.8",
      "nanoid@>=4.0.0 <5.0.9": ">=5.0.9",
      "esbuild@<=0.24.2": ">=0.25.0",
      "vitest@>=2.0.0 <2.1.9": ">=2.1.9",
      "vite@>=5.0.0 <=5.4.11": ">=5.4.12",
      "@babel/runtime@<7.26.10": ">=7.26.10",
      "@babel/helpers@<7.26.10": ">=7.26.10",
      "vite@>=5.0.0 <5.4.15": ">=5.4.15",
      "axios@>=1.0.0 <1.8.2": ">=1.8.2",
      "vite@>=5.0.0 <5.4.16": ">=5.4.16",
      "vite@>=5.0.0 <5.4.17": ">=5.4.17",
      "vite@>=5.0.0 <5.4.18": ">=5.4.18"
    }
  }
}
