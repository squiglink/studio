{
  "name": "squiglink-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.6",
    "@tailwindcss/vite": "^4.1.11",
    "axios": "^1.11.0",
    "flowbite": "^3.1.2",
    "flowbite-vue": "^0.2.1",
    "pinia": "^3.0.3",
    "ts-case-convert": "^2.1.0",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "vue3-toastify": "^0.2.8"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.0",
    "@playwright/test": "^1.54.2",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.2.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/eslint-plugin": "1.3.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-plugin-oxlint": "^1.11.1",
    "eslint-plugin-playwright": "^2.2.2",
    "eslint-plugin-vue": "^10.4.0",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.11.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.9.3",
    "vite": "^7.1.1",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5"
  },
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.8": ">=3.3.8",
      "nanoid@>=4.0.0 <5.0.9": ">=5.0.9",
      "esbuild@<=0.24.2": ">=0.25.0",
      "vitest@>=2.0.0 <2.1.9": ">=2.1.9",
      "vite@>=5.0.0 <=5.4.11": ">=5.4.12",
      "@babel/runtime@<7.26.10": ">=7.26.10",
      "@babel/helpers@<7.26.10": ">=7.26.10",
      "vite@>=5.0.0 <5.4.15": ">=5.4.15",
      "axios@>=1.0.0 <1.8.2": ">=1.8.2",
      "vite@>=5.0.0 <5.4.16": ">=5.4.16",
      "vite@>=5.0.0 <5.4.17": ">=5.4.17",
      "vite@>=5.0.0 <5.4.18": ">=5.4.18"
    },
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild"
    ]
  }
}
